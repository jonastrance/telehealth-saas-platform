# Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (PostgreSQL with encryption)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telehealth_db
DB_USER=telehealth_user
DB_PASSWORD=your_secure_password
DB_SSL=true
DB_ENCRYPTION_KEY=your_32_character_encryption_key

# JWT Secret (use strong random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Session Configuration (HIPAA compliance)
SESSION_TIMEOUT=15m
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30m

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# WebRTC/Video Configuration
TURN_SERVER_URL=turn:your-turn-server.com
TURN_SERVER_USERNAME=your_turn_username
TURN_SERVER_CREDENTIAL=your_turn_credential
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_BASIC=price_your_basic_plan_id
STRIPE_PRICE_ID_PRO=price_your_pro_plan_id

# Logging
LOG_LEVEL=info
LOG_FILE=logs/telehealth.log

# Audit Logging (HIPAA requirement)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=logs/audit.log

# Data Retention (HIPAA requirement)
DATA_RETENTION_DAYS=2555
LOG_RETENTION_DAYS=2555

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@telehealth.com
